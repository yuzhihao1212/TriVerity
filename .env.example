# Copy to .env and fill in your own values.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Set true for Hy3: the max_tokens limits assume thinking is off (with it on, replies get cut off and fall back).
LLM_DISABLE_THINKING=false
DATABASE_URL=sqlite:///./ryde_disputes.db
# Public demo: PUBLIC_DEMO=true serves the samples only; access codes (one per judge,
# made with scripts/setup_demo_access.py) let invited judges submit their own disputes.
PUBLIC_DEMO=false
DEMO_ACCESS_CODES=
# Rate limits and the daily LLM budget (defaults in backend/app/core/limits.py:
# 3/min and 30/day per IP, 10/min in total, 300,000 tokens or 75 resolves a day).
# Overrides are logged at start-up; GLOBAL_PER_MINUTE may be at most 10.
# A resolve measured ~2,900 tokens in the live run. Uncomment ONE preset.
#
# Preset 1: local development and evaluation runs. Everyone on localhost is
# 127.0.0.1, so the default 3/min per IP is too tight. Set the token budget to
# fit the run: when it is spent, results silently switch to Fallback (the log
# says "Daily LLM budget spent"), so check explanation_source in eval results.
# PER_IP_PER_MINUTE=10
# PER_IP_PER_DAY=1000
# DAILY_TOKEN_BUDGET=1000000
# DAILY_RESOLVE_BUDGET=350
#
# Preset 2: the public demo server (behind the HTTPS proxy, so each visitor has
# their own IP). Samples are cached, so visitor clicks are nearly free; judges
# with access codes get 5/min and 40/day each. Keep the token budget below the
# demo key's TokenHub quota (e.g. 500,000) so the app degrades to Fallback
# before the provider starts refusing requests.
# PER_IP_PER_MINUTE=5
# PER_IP_PER_DAY=60
# PER_CODE_PER_MINUTE=5
# PER_CODE_PER_DAY=40
# GLOBAL_PER_MINUTE=10
# DAILY_TOKEN_BUDGET=400000
# DAILY_RESOLVE_BUDGET=85
