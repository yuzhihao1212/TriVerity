# Copy to .env and fill in your own values.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_DISABLE_THINKING=false
DATABASE_URL=sqlite:///./ryde_disputes.db
# Public demo: PUBLIC_DEMO=true serves the samples only; access codes (one per judge,
# made with scripts/setup_demo_access.py) let invited judges submit their own disputes.
PUBLIC_DEMO=false
DEMO_ACCESS_CODES=
# Optional overrides of backend/app/core/limits.py, e.g. for a local evaluation run.
# Leave unset on the demo server. GLOBAL_PER_MINUTE may be at most 10.
# DAILY_TOKEN_BUDGET=300000
# DAILY_RESOLVE_BUDGET=75
# PER_IP_PER_MINUTE=3
# PER_IP_PER_DAY=30
# GLOBAL_PER_MINUTE=10
# PER_CODE_PER_MINUTE=3
# PER_CODE_PER_DAY=20
